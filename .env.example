# Railway Postgres (same instance as WB4U backend)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Tableau scraper settings
WB4U_TABLEAU_URL=https://public.tableau.com/views/MonitorConsumentenmarktEnergie/Variabeleenvastecontracten
WB4U_TABLEAU_DELAY_MS=700
WB4U_RETRY_MAX_ATTEMPTS=3

# Logging
WB4U_LOG_LEVEL=INFO
WB4U_LOG_JSON=false

# Schema drift
WB4U_DRIFT_FAIL_ON_MISSING_COLUMNS=true
WB4U_DRIFT_FAIL_ON_NEW_COLUMNS=false
