# Railway Postgres (same instance as WB4U backend)
DATABASE_URL=postgresql://user:password@host:port/dbname

# Tableau scraper settings
WB4U_TABLEAU_URL=https://public.tableau.com/views/MonitorConsumentenmarktEnergie/Variabeleenvastecontracten
WB4U_TABLEAU_DELAY_MS=700
WB4U_RETRY_MAX_ATTEMPTS=3

# Logging
WB4U_LOG_LEVEL=INFO
WB4U_LOG_JSON=false

# Schema drift
WB4U_DRIFT_FAIL_ON_MISSING_COLUMNS=true
WB4U_DRIFT_FAIL_ON_NEW_COLUMNS=false

# ENTSO-E Transparency Platform (Data Fetch APIs / Entsoe)
ENTSOE_TOKEN=your-entsoe-security-token

KNMI_API_KEY=your-knmi-dataplatform-api-key

# Tibber Data API (Tibber api/) - OAuth2 client from https://thewall.tibber.com/clients/manage/
# (no personal access tokens; tokens are stored in "Tibber api/tokens.json" after `python tibber_auth.py login`)
TIBBER_CLIENT_ID=your-tibber-oauth-client-id
TIBBER_CLIENT_SECRET=your-tibber-oauth-client-secret
TIBBER_REDIRECT_URI=http://localhost:8765/callback
TIBBER_HOME_ID=your-home-id-from-GET-/v1/homes
TIBBER_TOKEN=your-tibber-personal-access-token-for-the-graphql-api
