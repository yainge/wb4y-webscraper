  "lookup_helpers": {
    "estimate_feedin_cost": {
      "description": "Function template to estimate annual feed-in cost given provider, duration, and annual kWh",
      "pseudocode": "function estimate_feedin_cost(provider_id, contract_duration, annual_kwh_estimate):\n  if provider_id in FIXED_RATE_PROVIDERS:\n    rate = get_rate_for_duration(provider_id, contract_duration)\n    return annual_kwh_estimate * rate\n  elif provider_id in TIERED_PROVIDERS:\n    tier = find_tier(provider_id, annual_kwh_estimate)\n    return tier['cost_per_year_eur']\n  elif provider_id == 'engie':\n    return (4.89 * 12) + (annual_kwh_estimate * 0.115)\n  else:\n    return None",
      "implementation_in_python": [
        "from feed_in_tariffs import FIXED_RATE_PROVIDERS, TIERED_PROVIDERS, PROVIDER_RATES",
        "",
        "def estimate_feedin_cost(provider_id, contract_duration, annual_kwh):",
        "    if provider_id in ['eneco', 'oxxio', 'greenchoice', 'vrijopnaam', 'clean_energy']:",
        "        if provider_id in FIXED_RATE_PROVIDERS:",
        "            rate = PROVIDER_RATES[provider_id].get(contract_duration, 0)",
        "            return round(annual_kwh * rate, 2)",
        "    elif provider_id in TIERED_PROVIDERS:",
        "        for tier in TIERED_PROVIDERS[provider_id]['tiers']:",
        "            if tier['kwh_min'] <= annual_kwh <= (tier['kwh_max'] or float('inf')):",
        "                return tier['cost_per_year_eur']",
        "    elif provider_id == 'engie':",
        "        return round((4.89 * 12) + (annual_kwh * 0.115), 2)",
        "    return None"
      ]
    },

    "get_dynamic_handling": {
      "description": "Look up how a provider handles feed-in compensation/charges for dynamic contracts",
      "lookup_table": {
        "receive_full_compensation": {"providers": ["Zonneplan", "Frank Energie"], "customer_outcome": "POSITIVE"},
        "pay_procurement_charge": {"providers": ["EasyEnergy", "NextEnergy", "Pure Energie", "Innova"], "customer_outcome": "NEGATIVE"},
        "pay_on_surplus_only": {"providers": ["Energiedirect", "VandeBron", "Essent", "Vattenfall", "Eneco", "Tibber"], "customer_outcome": "NEUTRAL"},
        "no_charge_no_compensation": {"providers": ["Budget Energie", "Coolblue Energie", "EnergyZero", "ANWB Energie"], "customer_outcome": "NEUTRAL"}
      }
    },

    "find_contract_duration_tier": {
      "description": "Map contract duration string to rate or tier lookup key",
      "mappings": {
        "1_jaar": ["1 jaar", "1-year", "1 year", "1yr"],
        "3_jaar": ["3 jaar", "3-year", "3 year", "3yr"],
        "2_jaar": ["2 jaar", "2-year", "2 year", "2yr"],
        "variabel": ["variabel", "variable", "variabele", "floating"],
        "vast": ["vast", "fixed", "vaste"]
      }
    }
  },

  "integration_sql_patterns": {
    "enrich_contracts_with_feedin": "UPDATE contracts SET feed_in_cost_estimate_eur = estimate_feedin_cost(provider_id, contract_duration, 3000) WHERE contract_type IN ('fixed', 'variable') AND solar_installation = true",

    "rank_providers_by_feedin_cost": "SELECT provider_id, AVG(estimated_cost) as avg_feedin_cost FROM estimated_feedin_costs GROUP BY provider_id ORDER BY estimated_cost ASC",

    "identify_dynamic_best_for_solar": "SELECT provider_id, dynamic_handling FROM provider_index WHERE has_dynamic_contracts = true ORDER BY CASE WHEN dynamic_handling = 'receive_full_compensation' THEN 1 WHEN dynamic_handling = 'pay_on_surplus_only' THEN 2 WHEN dynamic_handling = 'no_charge_no_compensation' THEN 3 ELSE 4 END"
  },

