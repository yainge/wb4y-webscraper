  "calculation_guides": {
    "tiered_staffels": {
      "description": "Customer's annual feed-in volume determines which tier applies; cost = tier bracket cost",
      "implementation": "Find tier where kwh_min <= annual_kwh <= kwh_max; return cost_per_year_eur or (cost_per_month_eur * 12)",
      "example": "5000 kWh at Essent: Falls in 4751-5000 tier → €633.84/year"
    },

    "fixed_rate_per_kwh": {
      "description": "Simple multiplication: annual_kwh × rate_per_kwh = total_annual_cost",
      "implementation": "cost_eur = annual_kwh × rate_per_kwh",
      "note": "Rate varies by contract duration for some providers (Eneco, Greenchoice, Oxxio)",
      "example": "5000 kWh at Eneco 1-year contract: 5000 × 0.146 = €730/year"
    },

    "fixed_fee_plus_variable_rate": {
      "description": "Monthly fixed fee + per-kWh variable rate",
      "implementation": "total_cost = (fixed_fee_per_month × 12) + (annual_kwh × variable_rate_per_kwh)",
      "example": "5000 kWh at Engie: (€4.89 × 12) + (5000 × €0.115) = €58.68 + €575 = €633.68/year"
    },

    "higher_fixed_rate": {
      "description": "Feed-in costs incorporated into higher monthly supply fee (not separately itemized)",
      "implementation": "No separate calculation; included in base contract pricing. Use example data to estimate impact.",
      "example": "Coolblue Energie ~1800 kWh solar → €280/year extra vs non-solar customers (€114/year baseline)"
    }
  },

  "dynamic_contract_strategies": {
    "receive_full_compensation": {
      "strategy": "RECEIVE",
      "description": "Hourly feed-in price = hourly consumption price",
      "customer_outcome": "Receives maximum compensation",
      "providers": ["Zonneplan", "Frank Energie"],
      "calculation": "No additional charges; compensation = market hourly rate"
    },

    "pay_procurement_charge": {
      "strategy": "PAY",
      "description": "Customer must pay procurement charge (inkoopvergoeding) on ALL feed-in kWh",
      "customer_outcome": "Negative: pays extra on every kWh fed back",
      "providers": ["EasyEnergy", "NextEnergy", "Pure Energie", "Innova"],
      "calculation": "For each kWh fed in, subtract procurement_charge from potential earnings"
    },

    "pay_on_surplus_only": {
      "strategy": "PAY_SURPLUS",
      "description": "Customer pays procurement charge ONLY on annual surplus (feed-in minus consumption)",
      "customer_outcome": "Better: only charged on net overproduction",
      "providers": ["Energiedirect", "VandeBron", "Essent", "Vattenfall", "Eneco", "Tibber"],
      "calculation": "annual_surplus = max(0, annual_feedin - annual_consumption); charge = annual_surplus × rate"
    },

    "no_charge_no_compensation": {
      "strategy": "NEUTRAL",
      "description": "No procurement charge paid, no compensation received on excess",
      "customer_outcome": "Neutral: receives market price for what you consume, nothing extra for surplus",
      "providers": ["Budget Energie", "Coolblue Energie", "EnergyZero", "ANWB Energie"],
      "calculation": "For consumption: full market price + inkoopvergoeding. For surplus: only market price (no inkoopvergoeding)"
    }
  },

  "integration_recommendations": {
    "storage_location": "Append feed_in_tariff_period and feed_in_cost columns to contracts.parquet",
    "lookup_key_fixed_variable": "provider_id + contract_duration + meter_type",
    "lookup_key_dynamic": "provider_id + dynamic_strategy",
    "calculation_trigger": "When contract_type IN ['fixed', 'variable', 'dynamic'] AND has_solar_panels = true",
    "enrichment_fields": [
      "feed_in_calculation_method",
      "feed_in_cost_annual_eur_estimate",
      "feed_in_cost_per_kwh_eur",
      "feed_in_cost_tiered_or_fixed",
      "dynamic_compensation_or_charge_eur_per_kwh"
    ],
    "validation_checks": [
      "Ensure contract_duration matches provider's tariff structure",
      "Verify provider_id exists in provider_index",
      "For dynamic contracts, confirm dynamic_handling field populated",
      "Validate calculated costs against example lookups in feed_in_tariffs.json"
    ],
    "estimation_based_on_kwh": {
      "low_solar": "0-1000 kWh/year → Use 500 kWh examples",
      "medium_solar": "1000-5000 kWh/year → Use 2000-3000 kWh examples",
      "high_solar": "5000+ kWh/year → Use 5000-10000 kWh examples",
      "unsure": "Default to 3000 kWh median"
    }
  },

